# /etc/nginx/conf.d/cbe.conf — HTTPS in front of the app (certificate from the organisation or Let's Encrypt)
server {
  listen 443 ssl http2;
  server_name cbe.raot.co.th;
  ssl_certificate     /etc/ssl/certs/cbe.raot.co.th.crt;
  ssl_certificate_key /etc/ssl/private/cbe.raot.co.th.key;
  client_max_body_size 12m;          # evidence files up to 10 MB
  proxy_read_timeout 60s;            # AI requests can take ~30 s
  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}
server { listen 80; server_name cbe.raot.co.th; return 301 https://$host$request_uri; }
